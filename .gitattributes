# Store and check out text files with LF endings on every OS. gofmt requires
# LF, and Git for Windows defaults to core.autocrlf=true, which would otherwise
# convert Go files to CRLF on checkout and make local lint runs fail.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.gif binary
*.pdf binary
